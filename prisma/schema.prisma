datasource db {
  provider = "mysql" // Or "postgresql" depending on your choice (TiDB uses mysql)
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  Exam
  Event
  General
}

enum Priority {
  Normal
  Urgent
}

model Notice {
  id          String   @id @default(uuid())
  title       String
  body        String   @db.Text
  category    Category
  priority    Priority @default(Normal)
  publishDate DateTime
  imageUrl    String? // Optional image string
  createdAt   DateTime @default(now())
}
